/-- SE-1: the zero-germ neighborhood property implies closed section support. -/
theorem closed_support_of_local_zero {X : Type*} [TopologicalSpace X]
    (Z : Set X) (h : ∀ x ∈ Z, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ U ⊆ Z) :
    IsClosed Zᶜ := by
  apply IsOpen.isClosed_compl
  rw [isOpen_iff_mem_nhds]
  intro x hx
  obtain ⟨U, hU, hxU, hUZ⟩ := h x hx
  exact Filter.mem_of_superset (hU.mem_nhds hxU) hUZ

/-- SE-3: the support submodule is exactly the kernel of restriction. -/
theorem restriction_kernel {R M N : Type*} [Ring R] [AddCommGroup M]
    [AddCommGroup N] [Module R M] [Module R N]
    (res : M →ₗ[R] N) (m : M) : m ∈ res.ker ↔ res m = 0 := Iff.rfl

/-- SE-8: finitely many finite lists of numerator generators lie in one finite submodule. -/
theorem finite_enlargement {R M : Type*} [Ring R] [AddCommGroup M] [Module R M]
    {ι : Type*} [Finite ι] (K : ι → Submodule R M) (hK : ∀ i, (K i).FG) :
    ∃ N : Submodule R M, N.FG ∧ ∀ i, K i ≤ N := by
  exact ⟨⨆ i, K i, Submodule.fg_iSup K hK, fun i => le_iSup K i⟩

/-- SE-8's affine enlargement: a finite localized module is generated by
one finite submodule of the original module. No finiteness of M is assumed. -/
theorem finite_submodule_spans_localization {R A M L : Type*}
    [CommRing R] [CommRing A] [Algebra R A]
    [AddCommGroup M] [Module R M] [AddCommGroup L]
    [Module R L] [Module A L] [IsScalarTower R A L]
    (S : Submonoid R) [IsLocalization S A] (f : M →ₗ[R] L)
    [IsLocalizedModule S f] [Module.Finite A L] :
    ∃ N : Submodule R M, N.FG ∧ N.localized' A S f = ⊤ := by
  classical
  obtain ⟨t, ht⟩ := (inferInstance : Module.Finite A L).1
  let T := IsLocalizedModule.finsetIntegerMultiple S f t
  refine ⟨Submodule.span R (T : Set M), Submodule.fg_span T.finite_toSet, ?_⟩
  rw [Submodule.localized'_span]
  apply top_unique
  rw [← ht]
  apply Submodule.span_le.mpr
  intro x hx
  let m := IsLocalizedModule.integerMultiple S f t id ⟨x, hx⟩
  have hm : m ∈ T := by
    exact Finset.mem_image.mpr ⟨⟨x, hx⟩, Finset.mem_attach _ _, rfl⟩
  have hfm : f m ∈ Submodule.span A (f '' (T : Set M)) :=
    Submodule.subset_span ⟨m, hm, rfl⟩
  rw [IsLocalizedModule.map_integerMultiple] at hfm
  apply (Submodule.smul_mem_iff_of_isUnit
    (Submodule.span A (f '' (T : Set M)))
    (IsLocalization.map_units A (IsLocalizedModule.commonDenom S f t id))).mp
  simpa only [algebraMap_smul, Submonoid.smul_def, id_eq] using hfm

/-- SE-9's affine terminal assertion: every element is in a finite submodule. -/
theorem finite_submodule_contains {R M : Type*} [Ring R] [AddCommGroup M]
    [Module R M] (m : M) : ∃ N : Submodule R M, N.FG ∧ m ∈ N := by
  exact ⟨Submodule.span R {m}, Submodule.fg_span_singleton m,
    Submodule.subset_span (Set.mem_singleton m)⟩

/-- SE-11: a relation vector zero in every residue field is zero over a reduced ring. -/
theorem reduced_relation_zero {R : Type*} [CommRing R] [_root_.IsReduced R]
    {ι : Type*} (v : ι → R) (h : ∀ (p : Ideal R), p.IsPrime → ∀ i, v i ∈ p) : v = 0 := by
  funext i
  exact (nilpotent_iff_mem_prime.mpr (fun p hp => h p hp i)).eq_zero

/-- SE-11: applying that coordinate calculation to every kernel vector proves injectivity. -/
theorem reduced_presentation_injective {R M : Type*} [CommRing R] [_root_.IsReduced R]
    [AddCommGroup M] [Module R M] {ι : Type*} (f : (ι → R) →ₗ[R] M)
    (h : ∀ v ∈ f.ker, ∀ (p : Ideal R), p.IsPrime → ∀ i, v i ∈ p) :
    Function.Injective f := by
  apply LinearMap.ker_eq_bot.mp
  apply le_antisymm _ bot_le
  intro v hv
  exact reduced_relation_zero v (h v hv)
end Supplements.SE

